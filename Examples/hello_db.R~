## a function to get you genomics data spread out in probe columns
genomedat = function(probes) {
    tcgas %>% 
        filter( probe %in% probes ) %>%
            select( -type ) %>%
                as_tibble %>% 
                    spread(probe, value)
}

genomedat( myprobes )

## a function to get you clinical + genomics data

clingeno = function(probes) {
    clinpheno %>% as_tibble %>%
        left_join( genomedat(probes) )
}

clingeno(myprobes)

## make a plot

library(ggplot2)

ggplot(  aes(x = FOXP3, y = ABCA1, color = OS, size = OS.time),
       data = clingeno( c("FOXP3", "ABCA1") ) )  +
           geom_point( alpha = 0.1 ) +
               geom_smooth(method = 'lm') +
                   facet_wrap( ~ tumtype )


